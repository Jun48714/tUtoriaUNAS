# Copia este archivo a ".env" (no se sube a git) y completa los valores.

# Dominio con el que se accederá (debe resolver a la IP de la VM). Ej.: tutoria.unas.edu.pe
TUTORIA_DOMAIN=tutoria.unas.edu.pe
# "internal" = certificado propio (red interna; los navegadores mostrarán advertencia hasta instalar la CA de Caddy).
# Para dominio público con puertos 80/443 abiertos, pon un correo de contacto y se usa Let's Encrypt.
TUTORIA_TLS=internal
# Puerto HTTPS publicado en la VM. Usa 8443 si el 443 ya está ocupado por otro proyecto.
HTTPS_PORT=8443
TUTORIA_EMAIL_DOMINIO=unas.edu.pe

# Genera con:  openssl rand -hex 24      (solo letras y números; se usa dentro de una cadena de conexión)
POSTGRES_PASSWORD=
# Genera con:  openssl rand -base64 48
CUENTAS_CODIGO_KEY=

# Correo saliente de códigos y accesos (STARTTLS, puerto 587). Gmail: contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_USUARIO=
SMTP_REMITENTE=
SMTP_PASSWORD=

# Solo para:  docker compose run --rm bootstrap   (la contraseña debe tener al menos 15 caracteres)
TUTORIA_ADMIN_EMAIL=
TUTORIA_ADMIN_PASSWORD=
TUTORIA_ADMIN_NOMBRES=
TUTORIA_ADMIN_APELLIDOS=
TUTORIA_ADMIN_ESCUELA=E-IIS
TUTORIA_SEMESTRE_ACTIVO=2026-II

# Correo por Microsoft Graph (vacio = usa SMTP_*). No escribas aqui el secreto real.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REMITENTE=

# Recordatorios de pendientes por correo: off | simulacion | activo
TUTORIA_RECORDATORIOS=off
GRAPH_NOMBRE=

# Validar el correo al instante en crear cuenta / olvidaste tu contrasena: true | false
TUTORIA_REVELAR_EXISTENCIA=false
